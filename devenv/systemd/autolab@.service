# Template systemd user unit for `autolab loop` — one instance per job:
#   systemctl --user enable --now autolab@<job-name>.service
#
# Step 5 (dev node setup) installs and adapts this; paths below assume
# agautolab is checked out at ~/agautolab and jobs live in ~/agautolab/jobs/.
# `uv` must be on the service PATH (or use an absolute path to it).

[Unit]
Description=autolab loop for job %i
After=network-online.target

[Service]
Type=exec
WorkingDirectory=%h/agautolab
ExecStart=%h/.local/bin/uv run autolab loop %h/agautolab/jobs/%i
# stuck (20) and error (30) are deliberate terminal verdicts, not crashes;
# restarting would only short-circuit with the same code again.
RestartPreventExitStatus=20 30
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
