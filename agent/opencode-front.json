{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "deny",
    "write": "deny",
    "bash": {
      "*": "deny",
      "uv run python -m agautolab.role_run director *": "allow",
      "python3 -m agautolab.role_run director *": "allow"
    }
  }
}
