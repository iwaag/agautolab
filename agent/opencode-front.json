{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "{env:AGENT_PROVIDER_OLLAMA_BASE_URL}" },
      "models": { "qwen3.6:35b-a3b-coding-nvfp4": {} }
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "deny",
    "write": "deny",
    "bash": {
      "*": "deny",
      "uv run python -m agautolab.role_run director *": "allow",
      "python3 -m agautolab.role_run director *": "allow"
    }
  }
}
