{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "write": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "deny",
      "git *": "allow",
      "uv *": "allow",
      "pytest *": "allow",
      "python3 *": "allow",
      "pip *": "allow",
      "node *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "make *": "allow",
      "curl *": "allow",
      "jq *": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "rm *": "allow",
      "chmod *": "allow",
      "touch *": "allow",
      "pwd": "allow",
      "cd *": "allow",
      "test *": "allow"
    },
    "external_directory": "allow"
  }
}
